{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5080"
      }
    }
  },
  "Simulation": {
    "Seed": 42,
    "TickIntervalMs": 1000,
    "AutoStart": true,
    "GroundTruthKey": "dev-ground-truth-key",
    "AiKey": "dev-ai-key",
    "AllowedOrigins": [
      "http://localhost:5500",
      "http://127.0.0.1:5500",
      "http://localhost:8080"
    ]
  }
}
